<?xml version="1.0" encoding="UTF-8"?>
<!--
  DLR PSS/E hourly study job: Windows Task Scheduler template (SCH-01).

  Placeholders only. Do not edit this file by hand and do not put a path, a user name or a secret
  in it. backend/psse_render_task.py fills the four tokens written between pairs of at-signs
  (PYTHON_EXE, ARGUMENTS, WORK_DIR, START_BOUNDARY) from paths that exist and writes the filled copy
  elsewhere. The job reads every setting (database, case, mapping) from its config file; the
  arguments carry only the path of that file.

  Honest scope: this file was checked as text and against the launcher's argument parser only.
  Nothing was registered with Windows Task Scheduler and Microsoft's schema was not run against it.
  Every statement below about what the real scheduler does is UNVERIFIED until the laptop session
  (runbook step 6, plan 03-07): that the scheduler accepts this XML, that a Repetition with an
  Interval and no Duration repeats indefinitely, that a quoted Command with spaces works, that the
  UTF-8 import works, that a standard user can register it, that WakeToRun wakes the laptop, that
  the battery flags are honoured and that the exit code reaches LastTaskResult.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>DLR PSS/E hourly study job. No secrets in this file.</Description>
  </RegistrationInfo>
  <Triggers>
    <!--
      One time trigger that repeats every hour. The Repetition has an Interval and no Duration, which
      is meant to repeat with no end (UNVERIFIED, runbook step 6: check NextRunTime after
      registering). The start minute (default 15) is set by the renderer: the live pipeline writes the
      hour's rating row a few minutes after the hour, and a start after about half past can find the
      previous row older than 90 minutes.
    -->
    <TimeTrigger>
      <StartBoundary>@@START_BOUNDARY@@</StartBoundary>
      <Enabled>true</Enabled>
      <Repetition>
        <Interval>PT1H</Interval>
      </Repetition>
    </TimeTrigger>
  </Triggers>
  <Principals>
    <!--
      Interactive token, least privilege, no stored password and no user element: the task runs for
      the person who registers it, only while that person is signed in, and needs neither an
      administrator right nor the batch logon right (UNVERIFIED, runbook step 6: that a standard
      user can register it).
    -->
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <!-- A run still going at the next hour is never overlapped; the new start is dropped. The job's own run lock is the second line against overlap. -->
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <!-- A laptop on battery still runs the job and is not stopped when unplugged (UNVERIFIED). -->
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <!-- The time limit below ends a run that hangs. -->
    <AllowHardTerminate>true</AllowHardTerminate>
    <!-- No catch-up run after a missed start: a missed hour stays a visible gap instead of a burst after wake. -->
    <StartWhenAvailable>false</StartWhenAvailable>
    <!-- The launcher checks the network itself before it connects. -->
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <!-- Ask the laptop to wake for the run (UNVERIFIED: unreliable on Modern Standby hardware). -->
    <WakeToRun>true</WakeToRun>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <!-- Under the hour and above the study's 1500 second budget plus load, solve overrun and write. -->
    <ExecutionTimeLimit>PT45M</ExecutionTimeLimit>
  </Settings>
  <Actions Context="Author">
    <!-- The renderer double-quotes the Command when it holds a space and double-quotes the entry script and the config file inside the Arguments (UNVERIFIED, runbook step 6). -->
    <Exec>
      <Command>@@PYTHON_EXE@@</Command>
      <Arguments>@@ARGUMENTS@@</Arguments>
      <WorkingDirectory>@@WORK_DIR@@</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
