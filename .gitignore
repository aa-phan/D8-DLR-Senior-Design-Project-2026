.venv
/outputs
# The accumulating historical archive (Phase 4) is generated data like
# outputs/, not source -- keeps the append-only file from being committed
# run-by-run.
/data/historical/
# Generated model artifacts and assembled training frames (v1.3 Phase 1) --
# like /data/historical/, not source; regenerable via forecast_training.py.
/data/models/
# Generated experiment caches and reports (v1.3 Phase 3) -- like
# /data/models/, not source; regenerable via forecast_leadtime_calibration.py
# and forecast_experiment.py.
/data/experiment/
# Shadow-prototype model artifacts and prediction logs (project pivot,
# 2026-10-05) -- generated/regenerable, like /data/experiment/, via
# forecast_shadow_pipeline.py.
/data/shadow/
.env
__pycache__/
*.pyc
.claude