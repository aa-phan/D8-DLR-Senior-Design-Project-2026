.venv
/outputs
# The accumulating historical archive (Phase 4) is generated data like
# outputs/, not source -- keeps the append-only file from being committed
# run-by-run.
/data/historical/
# Generated model artifacts and assembled training frames (v1.3 Phase 1) --
# like /data/historical/, not source; regenerable via forecast_training.py.
# The directory is excluded by contents (`/data/models/*`) rather than whole, because git
# cannot re-include a file inside an excluded directory. The eight per-city live models
# and their hash manifest are DELIBERATELY tracked (OD-10, 2026-10-19): the live workflow's
# runner has no other way to obtain them (it cannot retrain, and `data/models/` is not
# shipped otherwise) -- without them a run would silently go without its ML forecast and
# anomaly model. A retrain overwrites these files, so promoting one means regenerating
# LIVE_ARTIFACT_HASHES.sha256 (backend/dlr_live_check_models.py --write-manifest) and
# committing both (procedure in docs/data-science/decisions/dlr_live_runbook.md). Names are
# explicit, not `*.joblib`, so corridor-era files such as anomaly_AUSTIN_CORPUS_CHRISTI.joblib
# stay ignored. Everything else here (training frames, observation CSVs, reports, retrain
# logs, legacy_corridor_era/) stays generated and ignored.
/data/models/*
!/data/models/forecast_AUSTIN.joblib
!/data/models/forecast_CORPUS_CHRISTI.joblib
!/data/models/forecast_MIDLAND.joblib
!/data/models/forecast_EL_PASO.joblib
!/data/models/anomaly_AUSTIN.joblib
!/data/models/anomaly_CORPUS_CHRISTI.joblib
!/data/models/anomaly_MIDLAND.joblib
!/data/models/anomaly_EL_PASO.joblib
!/data/models/LIVE_ARTIFACT_HASHES.sha256
# Generated experiment caches and reports (v1.3 Phase 3) -- like
# /data/models/, not source; regenerable via forecast_leadtime_calibration.py
# and forecast_experiment.py.
/data/experiment/
# Shadow-prototype prediction logs and the collector's lock file (project
# pivot, 2026-10-05) -- generated per-run, not source.
# `/data/shadow/models/` is DELIBERATELY NOT ignored (2026-10-06): the
# trained .joblib artifacts there must reach the GitHub Actions runner,
# which has no other way to obtain them (no network access to retrain,
# and the cached ABLATION-basis data they're fit from isn't shipped
# either) -- without this carve-out every scheduled run silently falls
# back to raw_forecast, never producing the real ml_wind_corrected
# prediction the collector exists to log. Revisit if the model is
# retrained after the 2026-11-01 freeze point.
/data/shadow/predictions/
/data/shadow/.collect.lock
.env
# Supabase CLI scratch directories can hold the project reference and pooler details; only
# supabase/migrations/ is source.
/supabase/.temp/
/supabase/.branches/
__pycache__/
*.pyc
.claude
# Power Systems' case and city-to-branch mapping carry grid element identifiers and never
# enter this public repository (pss-e-integration Phase 2). Keep the real files in
# psse_local/; *.sav and *.raw are PSS/E saved-case and raw-case extensions (no tracked
# file uses them). Only docs/data-science/schema/psse_mapping_example.json is committed.
/psse_local/
*.sav
*.raw
